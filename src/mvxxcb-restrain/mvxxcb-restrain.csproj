<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mvxxcb-restrain</AssemblyName>
    <RootNamespace>MvxxcbRestrain</RootNamespace>
    <Version>0.3.2</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Description>External resource scheduler for background file scanners. Resource scheduling only; no injection, no blocking.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ReaLTaiizor" Version="3.8.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
