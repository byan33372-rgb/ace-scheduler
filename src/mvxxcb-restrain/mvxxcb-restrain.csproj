<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mvxxcb-restrain</AssemblyName>
    <RootNamespace>MvxxcbRestrain</RootNamespace>
    <Version>0.3.0</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Description>Schedule-friendly throttling for Tencent ACE (SGuard) background scans. Resource scheduling only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
